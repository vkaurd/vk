import random
def game():
    secret = random.randint(1, 100) # загадали число
    tr = 1 # счетчик попыток
    while tr <= 10:
        guess = int(input())
        if guess == secret:
            print('WIN')
            return # выходим из функции, конец игры
        elif guess < secret:
            print('Загаданное число больше.')
        else:
            print('Загаданное число меньше.')    
        tr = tr + 1 # переходим к следующей попытке
    print('Попытки кончились! Загаданное число было:', secret)
game()
