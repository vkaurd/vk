def find_min(l):   #ищем минимум
    nul=l[0]   #пусть минимум это 1 число в списке, с ним будем сравнивать
    for i in l:  #пробегаемся по списку
        if i < nul:  #сравним с 1 числом
            nul = i    #когда нашли, запоминаем его
    ind=[]       #здесь будут индексы
    for i in range(len(l)):  #тут пробегаемся не по списку, а по индексам
        if l[i] == nul:   #сравним с мин
            ind.append(i+1)   #если элемент равен минимальному, добавлем его индекс в список и прибавляем 1, тк в питоне индексация с 0
    return ind #возвращаем список найденных позиций

ourlist = []
print('Введите числа по очереди. Чтобы закончить, напишите stop')
a = input()
while a != "stop":
    ourlist.append(int(a))
    a = input()

answer = find_min(ourlist)
print("индекс минимального:", answer)

