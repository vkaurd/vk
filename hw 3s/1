import random  # подключаем модуль для случайных чисел
def nucl(length): # Список нуклеотидов
    letters = ['A', 'C', 'G', 'T'] 
    for i in range(length): # Запускаем цикл столько раз, какую длину надо
        random_index = random.randint(0, 3) # Выбираем случайную букву
        yield letters[random_index] # Выдаем одну случайную букву наружу и ставим функцию на паузу

size = int(input())
st = "" # пустая строка, сюда складываем буквы
for letter in nucl(size):
    st += letter  # добавляем букву к строке
print(st)
