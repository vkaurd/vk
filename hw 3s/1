def bubble_sort(l):
    n = len(l)
    for i in range(n):   # цикл отвечает за количество полных проходов
        for j in range(0, n - 1):   # а этот идет по элементам и сравнивает соседей. n-1 потому что пар соседей на 1 меньше
            if l[j] > l[j + 1]:   # если левый элемент больше правого
                l[j], l[j + 1] = l[j + 1], l[j]   # меняем их местами
                print(l)   # выводим список после перестановки
    return l   # возвращаем список

ourlist = []
print('Введите числа по очереди. Чтобы закончить, напишите stop')
a = input()
while a != "stop":
    ourlist.append(int(a))
    a = input()

print("Исходный список:", ourlist)
sorted_list = bubble_sort(ourlist)
print("Итоговый список:", sorted_list)

